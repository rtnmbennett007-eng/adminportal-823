rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Maple X Financial Portal Rules
    // Secure internal access for staff and portal administrators
    
    function isAuthenticated() {
      return request.auth != null;
    }

    match /clients/{clientId} {
      allow read, write: if true; // Internal operational system
    }

    match /deals/{dealId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }

    match /leads/{leadId} {
      allow read, write: if true;
    }

    match /staff/{staffId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
