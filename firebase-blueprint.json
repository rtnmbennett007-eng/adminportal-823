{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "Commercial funding client applicant and business profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "businessName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "currentStatus": { "type": "string" },
        "creditScore": { "type": "number" },
        "annualRevenue": { "type": "number" },
        "assignedStaff": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName", "businessName", "email"]
    },
    "FundingDeal": {
      "title": "FundingDeal",
      "description": "Commercial loan, line of credit, 0% card, or SBA deal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "product": { "type": "string" },
        "fundingAmount": { "type": "number" },
        "percentage": { "type": "number" },
        "status": { "type": "string" },
        "lenderName": { "type": "string" },
        "commissionStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "clientId", "product", "fundingAmount", "percentage", "status"]
    },
    "InternalTask": {
      "title": "InternalTask",
      "description": "Internal staff workflow task and notification reminder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "clientId": { "type": "string" },
        "assignedTo": { "type": "string" },
        "dueDate": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "assignedTo", "dueDate", "priority", "status"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Prospective funding applicant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "businessName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName", "businessName", "status"]
    },
    "StaffUser": {
      "title": "StaffUser",
      "description": "Internal team member and operational administrator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "jobTitle": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "role"]
    }
  },
  "firestore": {
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Master client records"
    },
    "/deals/{dealId}": {
      "schema": "FundingDeal",
      "description": "Funding deals and commission tracking"
    },
    "/tasks/{taskId}": {
      "schema": "InternalTask",
      "description": "Internal staff tasks"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Inbound intake leads"
    },
    "/staff/{staffId}": {
      "schema": "StaffUser",
      "description": "Maple X staff accounts"
    }
  }
}
